# Normalize all text files to LF in the repository, regardless of the
# platform or editor that wrote them. Git auto-detects text vs binary.
* text=auto eol=lf

# Binary assets - never touch their bytes.
*.png binary

# The CAS reference files are kept byte for byte, CRLF included, so they
# match the checksums in data/reference/README.md.
data/reference/**/*.csv -text
